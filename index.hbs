{{> head}}
{{> header}}

<main id="main">
{{#if @renderer.isFirstPage}}
   {{#if @config.custom.heroEnabled}}
      {{> hero}}
   {{/if}}

   {{!-- Platform expertise strip --}}
   {{#if @config.custom.platformsEnabled}}
      <section class="platforms reveal">
         <div class="wrap">
            {{#if @config.custom.platformsHeading}}<p class="platforms__heading eyebrow">{{@config.custom.platformsHeading}}</p>{{/if}}
            {{#if @config.custom.certificationsEnabled}}
               <div class="certs">
                  <span class="cert"><img src="{{@website.assetsUrl}}/images/partners/google-partner.svg" alt="Google Partner" loading="lazy" width="120" height="120"></span>
                  <span class="cert"><img src="{{@website.assetsUrl}}/images/partners/meta-business-partner.webp" alt="Meta Business Partner" loading="lazy" width="180" height="103"></span>
                  <span class="cert"><img src="{{@website.assetsUrl}}/images/partners/microsoft-partner.webp" alt="Microsoft Advertising Partner" loading="lazy" width="180" height="62"></span>
               </div>
            {{/if}}
         </div>
         <div class="platforms__rows">
            <div class="platforms__marquee">
               <div class="platforms__track">
                  <div class="platforms__group">{{{@config.custom.platformsList}}}</div>
                  <div class="platforms__group" aria-hidden="true">{{{@config.custom.platformsList}}}</div>
               </div>
            </div>
            {{#if @config.custom.platformsList2}}
               <div class="platforms__marquee platforms__marquee--rev">
                  <div class="platforms__track">
                     <div class="platforms__group">{{{@config.custom.platformsList2}}}</div>
                     <div class="platforms__group" aria-hidden="true">{{{@config.custom.platformsList2}}}</div>
                  </div>
               </div>
            {{/if}}
         </div>
      </section>
   {{/if}}

   {{!-- Stats band --}}
   {{#if @config.custom.statsEnabled}}
      <section class="stats reveal">
         <div class="wrap stats__grid">{{{@config.custom.statsItems}}}</div>
      </section>
   {{/if}}

   {{!-- Services --}}
   {{#if @config.custom.servicesEnabled}}
      <section class="section services reveal" id="services">
         <div class="wrap">
            <header class="section__head">
               {{#if @config.custom.servicesEyebrow}}<p class="eyebrow eyebrow--gold">{{@config.custom.servicesEyebrow}}</p>{{/if}}
               {{#if @config.custom.servicesTitle}}<h2 class="section__title">{{@config.custom.servicesTitle}}</h2>{{/if}}
            </header>
            <div class="services__grid">{{{@config.custom.servicesItems}}}</div>
         </div>
      </section>
   {{/if}}

   {{!-- Case studies (Featured posts) --}}
   {{#if @config.custom.workEnabled}}
      {{#if featuredPosts}}
         <section class="section work reveal" id="work">
            <div class="wrap">
               <header class="section__head">
                  {{#if @config.custom.workEyebrow}}<p class="eyebrow eyebrow--gold">{{@config.custom.workEyebrow}}</p>{{/if}}
                  {{#if @config.custom.workTitle}}<h2 class="section__title">{{@config.custom.workTitle}}</h2>{{/if}}
               </header>
               <div class="work__grid">
                  {{#each featuredPosts}}
                     <a class="work-card" href="{{url}}" data-event="view_case_study" data-event-title="{{title}}">
                        {{#featuredImage}}
                           {{#if url}}
                              <span class="work-card__media">
                                 <img src="{{url}}"
                                    {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.cards sizes.cards}}{{/if}}
                                    {{lazyload "lazy"}} width="{{width}}" height="{{height}}" alt="{{alt}}">
                              </span>
                           {{/if}}
                        {{/featuredImage}}
                        <span class="work-card__body">
                           {{#if mainTag}}<span class="chip chip--gold">{{mainTag.name}}</span>{{/if}}
                           <span class="work-card__title">{{title}}</span>
                           <span class="work-card__excerpt">{{{excerpt}}}</span>
                           <span class="work-card__link">{{translate 'post.readMore'}} &rarr;</span>
                        </span>
                     </a>
                  {{/each}}
               </div>
            </div>
         </section>
      {{/if}}
   {{/if}}
{{/if}}

{{!-- Insights / blog feed --}}
{{#if @config.custom.insightsEnabled}}
   {{#if posts}}
      <section class="section insights" id="insights">
         <div class="wrap">
            {{#if @renderer.isFirstPage}}
               <header class="section__head reveal">
                  {{#if @config.custom.insightsEyebrow}}<p class="eyebrow eyebrow--gold">{{@config.custom.insightsEyebrow}}</p>{{/if}}
                  {{#if @config.custom.insightsTitle}}<h2 class="section__title">{{@config.custom.insightsTitle}}</h2>{{/if}}
               </header>
            {{/if}}
            <div class="cards-grid">
               {{#if @renderer.isFirstPage}}
                  {{#if @config.custom.insightsGuideEnabled}}
                     {{#*inline "guideUrl"}}{{#if @config.custom.insightsGuideUrl}}{{@config.custom.insightsGuideUrl}}{{else}}{{@website.url}}luxury-resort-advertising-guide/{{/if}}{{/inline}}
                     <article class="card card--guide reveal">
                        <a class="card__media card--guide__media" href="{{> guideUrl}}" tabindex="-1" aria-hidden="true">
                           <span class="mark mark--on-navy mark--100" aria-hidden="true"></span>
                           <span class="card--guide__ribbon">Free PDF</span>
                        </a>
                        <div class="card__body">
                           <div class="card__meta">
                              <span class="chip chip--gold">{{#if @config.custom.insightsGuideEyebrow}}{{@config.custom.insightsGuideEyebrow}}{{else}}Free guide{{/if}}</span>
                           </div>
                           <h3 class="card__title">
                              <a href="{{> guideUrl}}" data-event="guide_promo_click" data-event-location="insights">{{#if @config.custom.insightsGuideTitle}}{{@config.custom.insightsGuideTitle}}{{else}}The luxury-hospitality direct-booking playbook{{/if}}</a>
                           </h3>
                           <p class="card__excerpt">{{#if @config.custom.insightsGuideText}}{{@config.custom.insightsGuideText}}{{else}}The margin spread, the DMA pricing window, the AI-agent shift — and a 90-day plan to grow direct bookings.{{/if}}</p>
                           <a class="card--guide__cta" href="{{> guideUrl}}" data-event="guide_promo_click" data-event-location="insights">{{#if @config.custom.insightsGuideCta}}{{@config.custom.insightsGuideCta}}{{else}}Read the guide{{/if}} <span aria-hidden="true">→</span></a>
                        </div>
                     </article>
                  {{/if}}
               {{/if}}
               {{#each posts}}
                  {{> post-card}}
               {{/each}}
            </div>
            {{> pagination}}
         </div>
      </section>
   {{/if}}
{{/if}}

{{!-- FAQ --}}
{{#if @renderer.isFirstPage}}
   {{#if @config.custom.faqEnabled}}
      <section class="section faq-section reveal" id="faq">
         <div class="wrap wrap--narrow">
            <header class="section__head section__head--center">
               <p class="eyebrow eyebrow--gold">FAQ</p>
               {{#if @config.custom.faqTitle}}<h2 class="section__title">{{@config.custom.faqTitle}}</h2>{{/if}}
            </header>
            <div class="faq-list">
               {{#if @config.custom.faqQ1}}<details class="faq"><summary class="faq__q">{{@config.custom.faqQ1}}</summary><div class="faq__a">{{@config.custom.faqA1}}</div></details>{{/if}}
               {{#if @config.custom.faqQ2}}<details class="faq"><summary class="faq__q">{{@config.custom.faqQ2}}</summary><div class="faq__a">{{@config.custom.faqA2}}</div></details>{{/if}}
               {{#if @config.custom.faqQ3}}<details class="faq"><summary class="faq__q">{{@config.custom.faqQ3}}</summary><div class="faq__a">{{@config.custom.faqA3}}</div></details>{{/if}}
               {{#if @config.custom.faqQ4}}<details class="faq"><summary class="faq__q">{{@config.custom.faqQ4}}</summary><div class="faq__a">{{@config.custom.faqA4}}</div></details>{{/if}}
            </div>
         </div>
      </section>
      <script type="application/ld+json">
      { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{#if @config.custom.faqQ1}}{ "@type": "Question", "name": {{{jsonify @config.custom.faqQ1}}}, "acceptedAnswer": { "@type": "Answer", "text": {{{jsonify @config.custom.faqA1}}} } }{{/if}}{{#if @config.custom.faqQ2}}{{#if @config.custom.faqQ1}}, {{/if}}{ "@type": "Question", "name": {{{jsonify @config.custom.faqQ2}}}, "acceptedAnswer": { "@type": "Answer", "text": {{{jsonify @config.custom.faqA2}}} } }{{/if}}{{#if @config.custom.faqQ3}}{{#checkIfAny @config.custom.faqQ1 @config.custom.faqQ2}}, {{/checkIfAny}}{ "@type": "Question", "name": {{{jsonify @config.custom.faqQ3}}}, "acceptedAnswer": { "@type": "Answer", "text": {{{jsonify @config.custom.faqA3}}} } }{{/if}}{{#if @config.custom.faqQ4}}{{#checkIfAny @config.custom.faqQ1 @config.custom.faqQ2 @config.custom.faqQ3}}, {{/checkIfAny}}{ "@type": "Question", "name": {{{jsonify @config.custom.faqQ4}}}, "acceptedAnswer": { "@type": "Answer", "text": {{{jsonify @config.custom.faqA4}}} } }{{/if}}] }
      </script>
   {{/if}}
{{/if}}

{{!-- CTA band --}}
{{#if @renderer.isFirstPage}}
   {{> cta-band}}
{{/if}}
</main>

{{> footer}}
