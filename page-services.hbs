{{> head}}
{{> header}}

<main class="main is-page-main is-services">
   {{#page}}
      {{#if @config.page.displayTitle}}
         <header class="archive-hero">
            <span class="landing-hero__mark mark mark--on-navy mark--120" aria-hidden="true"></span>
            <div class="wrap landing-hero__inner reveal">
               <p class="eyebrow eyebrow--light">What we do</p>
               <h1 class="archive-hero__title">{{title}}</h1>
               {{#if @config.page.introText}}<p class="landing-hero__lead">{{@config.page.introText}}</p>{{/if}}
            </div>
         </header>
      {{/if}}

      {{#if text}}
         <div class="landing__content entry entry--wide">
            {{{text}}}
         </div>
      {{/if}}

      {{#if @config.page.servicesList}}
         <section class="section">
            <div class="wrap">
               <div class="services-page-list">{{{@config.page.servicesList}}}</div>
            </div>
         </section>
      {{/if}}

      {{#if @config.page.displayChildPages}}
         {{#if subpages}}
            <section class="section subpages">
               <div class="wrap">
                  <h2 class="section__title">{{translate 'page.childPages'}}</h2>
                  <ul class="subpages__list subpages__list--grid">{{> subpages-list}}</ul>
               </div>
            </section>
         {{/if}}
      {{/if}}
   {{/page}}

   {{> cta-band}}
</main>

{{> footer}}
