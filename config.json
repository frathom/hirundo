{
    "name": "Hirundo",
    "version": "1.0.0",
    "author": "Hirundo",
    "url": "https://getpublii.com",
    "type": "theme",
    "menus": {
        "mainMenu": {
            "name": "Main menu",
            "desc": "Primary navigation shown in the header",
            "maxLevels": 2
        },
        "footerMenu": {
            "name": "Footer menu",
            "desc": "Compact link list shown in the footer",
            "maxLevels": 1
        }
    },
    "renderer": {
        "renderRelatedPosts": true,
        "relatedPostsNumber": 3,
        "renderSimilarPosts": false,
        "renderPrevNextPosts": true,
        "createContentStructure": true,
        "includeFeaturedInPosts": false,
        "tagsIncludeFeaturedInPosts": true,
        "authorsIncludeFeaturedInPosts": true,
        "featuredPostsNumber": 3,
        "tagsFeaturedPostsNumber": 0,
        "authorsFeaturedPostsNumber": 0,
        "createTagPages": true,
        "createAuthorPages": true,
        "createTagsList": true,
        "create404page": true,
        "createSearchPage": false,
        "customHTML": {
            "beforePost": "Before every post",
            "afterPost": "After every post",
            "beforePage": "Before every page",
            "afterPage": "After every page"
        }
    },
    "supportedFeatures": {
        "blockEditor": true,
        "tagsList": true,
        "tagPages": true,
        "tagImages": true,
        "authorPages": true,
        "authorImages": true,
        "searchPage": false,
        "errorPage": true,
        "customSearch": false,
        "customComments": true,
        "embedConsents": true,
        "pages": true
    },
    "postTemplates": {
        "wide": "Wide — full-bleed featured image"
    },
    "pageTemplates": {
        "landing": "Landing — full-width marketing sections",
        "services": "Services — detailed offerings",
        "team": "Team — member grid",
        "contact": "Contact — form + details",
        "empty": "Empty container (build with blocks)"
