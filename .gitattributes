# Normalise line endings: store text as LF in the repo
* text=auto eol=lf

# Explicit text types
*.hbs   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf

# Binary assets (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.woff2 binary
*.zip   binary
