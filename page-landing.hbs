{{> head}}
{{> header}}

<main class="main is-landing">
   {{#page}}
      {{#if @config.page.displayTitle}}
         <header class="landing-hero">
            <span class="landing-hero__mark mark mark--on-navy mark--120" aria-hidden="true"></span>
            <div class="wrap landing-hero__inner reveal">
               <h1 class="landing-hero__title">{{title}}</h1>
               {{#if @config.page.introText}}<p class="landing-hero__lead">{{@config.page.introText}}</p>{{/if}}
            </div>
         </header>
      {{/if}}

      {{#if @config.page.displayFeaturedImage}}
         {{#featuredImage}}
            {{#if url}}
               <figure class="wrap landing__featured">
                  <img src="{{url}}"
                     {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}{{/if}}
                     {{lazyload "eager"}} width="{{width}}" height="{{height}}" alt="{{alt}}">
               </figure>
            {{/if}}
         {{/featuredImage}}
      {{/if}}

      <div class="landing__content entry entry--wide">
         {{{text}}}
      </div>

      {{#if @config.page.displayChildPages}}
         {{#if subpages}}
            <section class="section subpages">
               <div class="wrap">
                  <h2 class="section__title">{{translate 'page.childPages'}}</h2>
                  <ul class="subpages__list subpages__list--grid">{{> subpages-list}}</ul>
               </div>
            </section>
         {{/if}}
      {{/if}}
   {{/page}}

   {{#if @config.custom.ctaEnabled}}
      <section class="cta-band reveal">
         <div class="wrap cta-band__inner">
            <div>
               {{#if @config.custom.ctaTitle}}<h2 class="cta-band__title">{{@config.custom.ctaTitle}}</h2>{{/if}}
               {{#if @config.custom.ctaText}}<p class="cta-band__text">{{@config.custom.ctaText}}</p>{{/if}}
            </div>
            {{#if @config.custom.ctaButtonLabel}}<a class="btn btn--gold btn--lg" href="{{@config.custom.ctaButtonUrl}}">{{@config.custom.ctaButtonLabel}}</a>{{/if}}
         </div>
      </section>
   {{/if}}
</main>

{{> footer}}
