{{!-- BreadcrumbList — include inside a {{#post}} or {{#page}} block (needs title/url) --}}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{@website.url}}" }, { "@type": "ListItem", "position": 2, "name": {{{jsonify title}}}, "item": "{{url}}" } ] }
</script>
