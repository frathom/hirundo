{{!-- Site header / primary navigation. On the homepage hero it overlays the
      navy hero and turns solid on scroll (see scripts.js). The CSS picks the
      dark or light logo based on the header state, so both are output. --}}
<header class="site-header{{#if @config.custom.headerSticky}} site-header--sticky{{/if}}{{#is "index"}}{{#if @config.custom.heroEnabled}} site-header--overlay{{/if}}{{/is}}"
        data-overlay="{{#is "index"}}{{#if @config.custom.heroEnabled}}1{{/if}}{{/is}}">
   <div class="wrap site-header__inner">
      <a class="brand" href="{{@website.url}}" aria-label="{{@website.name}}">
         {{#if @website.logo}}
            <img class="brand__logo" src="{{@website.logo}}" alt="{{@website.name}}"
                 width="{{@website.logoSize.width}}" height="{{@website.logoSize.height}}">
         {{else}}
            <span class="mark brand__mark" aria-hidden="true"></span>
            <span class="brand__name">{{@website.name}}</span>
         {{/if}}
      </a>

      <button class="nav-toggle" aria-label="{{translate 'partials.menu.label'}}" aria-expanded="false" aria-controls="primary-nav">
         <span class="nav-toggle__bar"></span>
         <span class="nav-toggle__bar"></span>
         <span class="nav-toggle__bar"></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="{{translate 'partials.menu.label'}}">
         {{#if menus.mainMenu}}
            {{> menu menus.mainMenu}}
         {{/if}}
         {{#if @config.custom.headerCtaLabel}}
            {{#if @config.custom.calEnabled}}
               <a class="btn btn--gold nav-cta"
                  href="https://cal.com/{{@config.custom.calLink}}"
                  data-event="book_call" data-event-location="header"
                  data-cal-link="{{@config.custom.calLink}}"
                  data-cal-namespace="{{@config.custom.calNamespace}}"
                  data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'>{{@config.custom.headerCtaLabel}}</a>
            {{else}}
               <a class="btn btn--gold nav-cta" href="{{@config.custom.headerCtaUrl}}" data-event="book_call" data-event-location="header">{{@config.custom.headerCtaLabel}}</a>
            {{/if}}
         {{/if}}
      </nav>
   </div>
</header>
